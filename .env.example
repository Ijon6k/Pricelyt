# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pricelyt_db
# Go API
APP_PORT=8080
# Admin key guards DELETE /api/trackers/{id}. Generate a strong value:
#   openssl rand -hex 24
# The frontend holds this server-side only (delete action) — never exposed
# to the browser. Must match between api and frontend services.
ADMIN_KEY=change-me
# Comma-separated allowed CORS origins (the public URL the app is served from).
CORS_ORIGINS=http://localhost:4444
# Exchange rate to normalize a detected IDR price back to USD in the scraper.
# Set to 1 to disable normalization (e.g. when scraping a USD-native source).
IDR_TO_USD_RATE=16200
